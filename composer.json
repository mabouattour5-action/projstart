{
    "name": "spark-it/projstart",
    "description": "A small PHP app used to learn CI/CD",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "ci": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "stan": "Run PHPStan static analysis",
        "cs": "Report coding standard violations without changing files",
        "cs:fix": "Rewrite files to match the coding standard",
        "ci": "Run every check the pipeline runs"
    }
}
